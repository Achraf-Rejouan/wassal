# Reverse proxy in front of TWO gateway instances (architecture review F-7).
#
# Two instances by default, not just in tests: cross-instance WebSocket fan-out is the design's
# headline capability, and a demo that runs one gateway would leave it visible only inside a
# test nobody runs.
{
	admin off
}

:80 {
	reverse_proxy gateway-1:8080 gateway-2:8080 {
		lb_policy round_robin

		# ACTIVE health checks, added after the chaos suite found the failure they prevent.
		# Caddy resolves an upstream's address when the config loads; a container that is
		# killed and restarted comes back on a NEW IP, so without re-checking the proxy keeps
		# sending traffic to an address nothing is listening on and returns 502 — even though
		# both gateways are healthy and reachable directly (see docs/bug-log.md).
		health_uri /actuator/health
		health_interval 3s
		health_timeout 2s

		# Retry the OTHER peer rather than surfacing the error. A gateway holds no domain
		# state, so any instance will do — which is the whole reason there are two.
		#
		# No passive `fail_duration` here on purpose: combined with active checks it kept
		# peers in a failed window after they had already recovered, turning a transient 502
		# into a sustained 503.
		lb_try_duration 5s
		lb_try_interval 250ms

		# Sticky sessions are deliberately NOT used. Any instance can serve any socket because
		# Redis Pub/Sub connects them; pinning would delete the problem instead of solving it.
	}
}
